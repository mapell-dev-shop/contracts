{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderPlaced v1",
  "description": "Published by orders-service when a customer places an order.",
  "type": "object",
  "required": ["event_id", "type", "version", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "type": {"const": "OrderPlaced"},
    "version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "data": {
      "type": "object",
      "required": ["order_id", "lines", "total_cents"],
      "properties": {
        "order_id": {"type": "string"},
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sku", "quantity", "unit_price_cents"],
            "properties": {
              "sku": {"type": "string"},
              "quantity": {"type": "integer", "minimum": 1},
              "unit_price_cents": {"type": "integer", "minimum": 0}
            }
          }
        },
        "total_cents": {"type": "integer", "minimum": 0}
      }
    }
  }
}
