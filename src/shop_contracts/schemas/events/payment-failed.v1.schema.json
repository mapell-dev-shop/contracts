{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentFailed v1",
  "description": "Published by payments-service when the payment for an order cannot be captured.",
  "type": "object",
  "required": ["event_id", "type", "version", "occurred_at", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "type": {"const": "PaymentFailed"},
    "version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "data": {
      "type": "object",
      "required": ["order_id", "reason"],
      "properties": {
        "order_id": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}
